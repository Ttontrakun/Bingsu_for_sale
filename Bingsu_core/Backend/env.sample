# ============================================
# Enterprise AI Chatbot / Bingsu Backend - Environment Variables
# ============================================
# คัดลอกไปเป็น .env หรือ .env.local แล้วเติมค่าจริง (อย่าใส่ key ในไฟล์นี้แล้ว commit)
# Docker Compose โหลด: Backend/.env และ Backend/.env.local

# ============================================
# Server Configuration
# ============================================
ENV=development
HOST=0.0.0.0
PORT=5052

# ============================================
# Frontend / API URLs
# ============================================
FRONTEND_URL=https://sale.ntaisolution.com
API_BASE_URL=http://localhost:8083
# URL หลักของระบบ (สำหรับ LINE Webhook / Ngrok) — เติมเมื่อ deploy หรือใช้ LINE
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:8083,http://localhost:3014,http://127.0.0.1:3000,http://127.0.0.1:3014,https://sale.ntaisolution.com,http://sale.ntaisolution.com,https://www.sale.ntaisolution.com,https://sale-admin.ntaisolution.com,http://sale-admin.ntaisolution.com,https://www.sale-admin.ntaisolution.com

# ============================================
# Database (Docker: postgres ที่ 5436 จาก host)
# ============================================
# จาก host: localhost:5436 | ใน Docker: postgres:5432 (compose override)
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/ask_the_manual?schema=public

# ============================================
# Qdrant (Docker: 6336 จาก host)
# ============================================
QDRANT_URL=http://localhost:6336
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_DISTANCE=Cosine
QDRANT_TOP_K=12

# ============================================
# Redis (Docker: 6382 จาก host)
# ============================================
REDIS_URL=redis://localhost:6382
RATE_LIMIT_REDIS_PREFIX=rate
UPLOAD_QUEUE_MODE=memory

# ============================================
# Auth / Session
# ============================================
SESSION_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
ALLOW_SIGNUP_AUTO_APPROVE=false
STRICT_PRIVACY_MODE=false
SYSTEM_LOG_RETENTION_DAYS=180
SYSTEM_LOG_RETENTION_INTERVAL_MS=3600000
MESSAGE_STORE_REDACTION=false
FULL_USER_MESSAGE_REDACTION=false
CHAT_RETENTION_DAYS=0
CHAT_RETENTION_INTERVAL_MS=3600000
# Seed admin/support (optional; used by seed-admins script)
# ALLOW_PROD_SEED=false
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=System Admin
# SEED_ADMIN_PASSWORD=
# SEED_SUPPORT_EMAIL=
# SEED_SUPPORT_NAME=Support Admin
# SEED_SUPPORT_PASSWORD=
# SEED_EXTRA_USER_EMAIL=
# SEED_EXTRA_USER_NAME=Extra User
# SEED_EXTRA_USER_PASSWORD=
# SEED_EXTRA_USER_ROLE=user

# ============================================
# Rate Limiting / โควต้าแชท
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
FREE_DAILY_TOKEN_LIMIT=500000
FREE_KNOWLEDGE_LIMIT=30
MAX_DAILY_CHAT_MESSAGES=2000
MAX_CHAT_HISTORY_MESSAGES=50

# ============================================
# Embeddings — เติม API key ใน .env จริง
# ============================================
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://aigateway.ntictsolution.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=10000

# ============================================
# RAG / Rerank
# ============================================
RAG_TIMEOUT_MS=2000
RAG_QUERY_VARIANT_LIMIT=4
RAG_RERANK_ENABLED=true
RAG_RERANK_RETRIEVE_MULTIPLIER=2
RAG_EXTERNAL_RERANK_ENABLED=true
RAG_EXTERNAL_RERANK_URL=https://aigateway.ntictsolution.com/v1/rerank
RAG_EXTERNAL_RERANK_API_KEY=
RAG_EXTERNAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_EXTERNAL_RERANK_TIMEOUT_MS=10000

# คำตอบสำเร็จรูป (ราคา/อำนาจ/กฎกับดัก) — true = เปิดใช้
DETERMINISTIC_RULES_ENABLED=true

# ============================================
# OCR / PDF — เติม TYPHOON_OCR_API_KEY ใน .env จริงถ้าใช้ Typhoon
# ============================================
PDF_PROVIDER=pdfplumber
PDF_TRY_TEXT_BEFORE_TYPHOON_OCR=true
PDF_TRY_PLUMBER_FIRST=true
OCR_ALWAYS_FOR_PDF=false
OCR_PROVIDER=typhoon
OCR_ENABLED=true
TYPHOON_OCR_API_KEY=
TYPHOON_OCR_API_URL=https://api.opentyphoon.ai/v1/ocr
OCR_LANG=th
OCR_MAX_PAGES=30
OCR_MIN_TEXT_CHARS=400

# ============================================
# Chat / LLM — primary + fallback + named gateways
# ============================================
# Primary (ค่าเริ่มต้นระบบ) — ตัวอย่าง Qwen ผ่าน NT AI Gateway
GATEWAY_BASE_URL=https://aigateway.ntictsolution.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen3.8-27B

# Fallback เมื่อ primary ล้ม/timeout
OPENAI_FALLBACK_BASE_URL=https://aigateway.ntictsolution.com/v1
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=rnd/openai/gpt-oss-120b
OPENAI_DEPLOYMENT_RETRY_ATTEMPTS=2
OPENAI_DEPLOYMENT_RETRY_BASE_DELAY_MS=2500

# Named gateways (เลือกโมเดลต่อบอทใน Supportadmin)
CHAT_NT_GATEWAY_URL=https://aigateway.ntictsolution.com/v1
CHAT_NT_API_KEY=
CHAT_NT_QWEN_API_KEY=
CHAT_NT_120B_API_KEY=
CHAT_H100_GATEWAY_URL=http://118.174.9.226:11435/v1
CHAT_H100_API_KEY=

CHAT_TIMEOUT_MS=120000
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=4000
# โหมด fast (ปิด thinking ของ Qwen) จำกัดความยาวคำตอบ
CHAT_FAST_MAX_TOKENS=1200

# OCR → LLM (ปุ่ม "จัดเรียงด้วย AI" / clean ข้อความ)
OCR_LLM_PROVIDER=openai
OCR_LLM_MODEL=gpt-4o-mini
# OCR_LLM_BASE_URL=   # ว่าง = ใช้ GATEWAY_BASE_URL
# OCR_LLM_API_KEY=    # ว่าง = ใช้ OPENAI_API_KEY

# ============================================
# File Upload
# ============================================
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md,.xlsx,.xls,.docx,.doc
MAX_UPLOAD_FILE_MB=200
MAX_UPLOAD_PART_MB=20
STORE_RAW_FILES=false
FILE_STORAGE_PROVIDER=local

# ============================================
# Text / Chunking
# ============================================
TEXT_CHUNK_SIZE=1800
TEXT_CHUNK_OVERLAP=100
PDF_SPLIT_PAGE_THRESHOLD=400
PDF_PAGES_PER_CHUNK=50
MAX_CONTEXT_PIECES=12
CONTEXT_NEIGHBOR_WINDOW=0

# ============================================
# Cache
# ============================================
CACHE_TTL_SECONDS=30

# ============================================
# Ngrok — เติมใน .env จริงเมื่อใช้ ngrok (LINE Webhook ฯลฯ)
# ============================================
# NGROK_AUTHTOKEN=

# ============================================
# LINE Messaging API — เติมใน .env จริงเมื่อเชื่อม LINE OA
# ============================================
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_DEFAULT_BOT_ID=

# ============================================
# Optional: S3, Email, etc.
# ============================================
# S3_ENDPOINT= S3_REGION= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_BUCKET=
# SMTP_SERVER=smtp.yourmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=aisupport@ntplc.co.th
# SMTP_PASSWORD=your-password
# SMTP_FROM=Enterprise AI Chatbot <aisupport@ntplc.co.th>
# EMAIL_SEND_RETRY_ATTEMPTS=3
# EMAIL_SEND_RETRY_BASE_DELAY_MS=1500
# EMAIL_ALERT_WEBHOOK_URL=
# EMAIL_ALERT_WEBHOOK_TOKEN=
# SUPPORT_APPROVAL_EMAIL=supportadmin@yourdomain.com
# SUPPORT_ADMIN_URL=http://localhost:3014/pending-users
# LOG_LEVEL=INFO
# NODE_ENV=development
